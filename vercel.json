{
  "framework": null,
  "devCommand": "node scripts/vercel-api-only.cjs",
  "crons": [
    {
      "path": "/api/admin-actions?action=auto-release-payments",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/marketplace-orders?action=auto-release",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/listing-actions?action=dispatch-weather-alert-notifications",
      "schedule": "15 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/unsubscribe",
      "destination": "/api/auth?action=unsubscribe"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
